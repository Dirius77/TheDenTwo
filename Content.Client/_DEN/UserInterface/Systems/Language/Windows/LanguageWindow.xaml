<windows:LanguageWindow
    xmlns="https://spacestation14.io"
    xmlns:windows="clr-namespace:Content.Client._DEN.UserInterface.Systems.Language.Windows"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc 'language-window-title'}"
    MinWidth="400"
    MinHeight="545">
    <BoxContainer Orientation="Vertical">
        <Label Text="{Loc 'language-ui-language-currently-speaking'}" Margin="2"></Label>
        <PanelContainer Name="CurrentlySpeaking" Access="Public">
        </PanelContainer>
        <controls:HLine Color="#404040" Thickness="4" Margin="0 4"/>
        <ScrollContainer HorizontalExpand="True" 
                         VerticalExpand="True" 
                         HScrollEnabled="False" 
                         VScrollEnabled="True" 
                         Margin="4">
            <BoxContainer Name="LanguageList" Access="Public" HorizontalExpand="True" Orientation="Vertical">
                <!-->Rest is filled in by LanguageUIController</-->
            </BoxContainer>
        </ScrollContainer>
    </BoxContainer>
</windows:LanguageWindow>
