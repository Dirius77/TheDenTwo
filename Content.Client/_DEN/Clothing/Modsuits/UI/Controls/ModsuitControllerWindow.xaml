        <BoxContainer Orientation="Vertical" HorizontalExpand="True">
            <Control>
                <PanelContainer Margin="100 0 0 0" StyleClasses="BackgroundPanelDark">
                </PanelContainer>
                <GridContainer Margin="10 10 10 10" Columns="2" Name="ToggleGrid">
                </GridContainer>
            </Control>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>