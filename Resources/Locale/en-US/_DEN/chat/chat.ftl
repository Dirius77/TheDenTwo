chat-language-identifier-wrap = [color={$color}][bold][font size={$size}]({$language})[/font][/bold][/color]{" "}
chat-language-entity-say-verb-prefix = [BubbleHeader][bold][Name]{$entityName}[/Name][/bold][/BubbleHeader] {$verb},{" "}
chat-language-entity-say-free-prefix = [BubbleHeader][bold][Name]{$entityName}[/Name][/bold][/BubbleHeader]{$space}
chat-language-entity-say-separation-prefix = [color=#636161]([/color][BubbleHeader][bold][Name]{$entityName}[/Name][/bold][/BubbleHeader][color=#636161])[/color]{" "}
chat-language-speech-wrap = [font={$fontType} size={$fontSize}][color={$color}]{$message}[/color][/font]
chat-language-entity-whisper-verb-prefix = [font size=11][italic][BubbleHeader][Name]{$entityName}[/Name][/BubbleHeader] whispers, [/italic][/font]
chat-language-entity-whisper-free-prefix = [font size=11][italic][BubbleHeader][Name]{$entityName}[/Name][/BubbleHeader]{$space}[/italic][/font]
chat-language-entity-whisper-separation-prefix = [font size=11][italic][color=#636161]([/color][BubbleHeader][Name]{$entityName}[/Name][/BubbleHeader][color=#636161])[/color] [/italic][/font]
chat-language-whisper-wrap = [italic][font={$fontType} size=11][color={$color}]{$message}[/color][/font][/italic]
chat-language-action-wrap = [italic]{$message}[/italic]
chat-language-action-whisper-wrap = [italic][font size=11]{$message}[/font][/italic]
chat-language-message-wrap = {$prefix}[BubbleContent]{$message}[/BubbleContent]
